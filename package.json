{
  "name": "context-capsule",
  "displayName": "Context Capsule",
  "description": "Capture and restore VS Code workspace context with Context Capsule.",
  "version": "0.1.0",
  "publisher": "context-capsule",
  "engines": { "vscode": "^1.125.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:context-capsule.inspect",
    "onCommand:context-capsule.sync",
    "onCommand:context-capsule.restore",
    "onCommand:context-capsule.diagnostics"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "restrictedConfigurations": ["contextCapsule.cliPath"] },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      { "command": "context-capsule.inspect", "title": "Context Capsule: Inspect VS Code Context" },
      { "command": "context-capsule.sync", "title": "Context Capsule: Sync VS Code Context" },
      { "command": "context-capsule.restore", "title": "Context Capsule: Restore VS Code Context from Capsule" },
      { "command": "context-capsule.diagnostics", "title": "Context Capsule: Connection Diagnostics" }
    ],
    "configuration": {
      "title": "Context Capsule",
      "properties": {
        "contextCapsule.cliPath": {
          "type": "string",
          "default": "capsule",
          "scope": "machine",
          "description": "Path to the Context Capsule CLI executable used for diagnostics and restoring saved VS Code snapshots. Live VS Code capture does not require the CLI process to stay running."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": { "diff": "^8.0.4", "serialize-javascript": "^7.0.6" }
}
